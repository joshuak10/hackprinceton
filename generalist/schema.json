{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swarmscope general environment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "description", "ticks", "roles", "actions"],
  "properties": {
    "version": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 12000},
    "guidelines": {"$ref": "#/$defs/texts"},
    "assumptions": {"$ref": "#/$defs/texts"},
    "ticks": {"type": "integer", "minimum": 1, "maximum": 1000, "description": "Discrete simulation steps. State transitions reserve resources at the start and apply effects at completion."},
    "world": {"$ref": "#/$defs/state"},
    "resources": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/resource"}},
    "roles": {"type": "array", "minItems": 1, "maxItems": 20, "description": "At most 500 actors in total across all roles.", "items": {"$ref": "#/$defs/role"}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/action"}},
    "metrics": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/metric"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
    "key": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$", "description": "A declared scalar state key. constructor, prototype and __proto__ are forbidden."},
    "scalar": {"type": ["string", "number", "boolean", "null"], "maxLength": 2000, "minimum": -1000000000, "maximum": 1000000000},
    "state": {"type": "object", "maxProperties": 64, "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/scalar"}},
    "texts": {"type": "array", "maxItems": 40, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "capacity"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 160}, "capacity": {"type": "integer", "minimum": 1, "maximum": 1000000}}
    },
    "role": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "goal", "count", "initialState"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 160}, "goal": {"type": "string", "minLength": 1, "maxLength": 2000}, "count": {"type": "integer", "minimum": 1, "maximum": 500}, "initialState": {"$ref": "#/$defs/id"}, "state": {"$ref": "#/$defs/state"}}
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["scope", "key", "op", "value"],
      "properties": {"scope": {"enum": ["world", "agent"]}, "key": {"$ref": "#/$defs/key"}, "op": {"enum": ["eq", "ne", "gte", "lte"]}, "value": {"$ref": "#/$defs/scalar"}}
    },
    "effect": {
      "type": "object", "additionalProperties": false, "required": ["scope", "key", "op", "value"],
      "properties": {"scope": {"enum": ["world", "agent"]}, "key": {"$ref": "#/$defs/key"}, "op": {"enum": ["set", "add"]}, "value": {"$ref": "#/$defs/scalar"}}
    },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["id", "units"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "units": {"type": "integer", "minimum": 1, "maximum": 1000000}}
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "from", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 2000},
        "roles": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "from": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "to": {"$ref": "#/$defs/id"},
        "duration": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1},
        "requirements": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/requirement"}},
        "effects": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/effect"}},
        "resources": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/claim"}},
        "weight": {"type": "number", "minimum": 0, "maximum": 1000000, "default": 1, "description": "Relative selection weight for the deterministic seeded rules baseline; not a Jev instruction."}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "scope", "key", "aggregation"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 160}, "scope": {"enum": ["world", "agent"]}, "key": {"$ref": "#/$defs/key"}, "aggregation": {"enum": ["sum", "mean", "min", "max"]}}
    }
  }
}
