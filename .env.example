# Template with no values. Safe to commit.
# Copy to .env.local and fill in the real values there.

HACKATHON_ZIP_PASSWORD=

MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
MATTERPORT_SDK_DOMAIN=

VERCEL_API_KEY=

# Jev (TypeSafe). The name TypeSafe's SDKs read.
TYPESAFE_API_KEY=
# Optional: Anthropic backend for env-build, plus legacy compile and advise.
# The default env-build backend uses the installed/authenticated Claude Code CLI.
ANTHROPIC_API_KEY=

# Optional executable path and model for the headless Claude environment builder.
# No value means `claude` on PATH and Claude Code's configured default model.
# SWARM_BUILDER_MODEL also overrides the Anthropic API model; it does not affect Codex.
SWARM_CLAUDE_BIN=
SWARM_BUILDER_MODEL=

# Optional executable path and model for --backend codex.
# No value means `codex` on PATH and its default model for the isolated job.
SWARM_CODEX_BIN=
SWARM_CODEX_MODEL=
